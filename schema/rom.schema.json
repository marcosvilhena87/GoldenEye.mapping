{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROM identity",
  "type": "object",
  "required": [
    "id",
    "sha256",
    "region",
    "revision",
    "format"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "region": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "format": {
      "enum": [
        "z64",
        "n64",
        "v64",
        "other"
      ]
    }
  },
  "additionalProperties": false
}
