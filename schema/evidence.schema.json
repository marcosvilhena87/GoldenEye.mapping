{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental evidence",
  "type": "object",
  "required": [
    "id",
    "rom_id",
    "environment",
    "procedure",
    "observations",
    "artifacts"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "rom_id": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "procedure": {
      "type": "string"
    },
    "observations": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
